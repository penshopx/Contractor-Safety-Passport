{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate:organization-integrity": "node --experimental-strip-types ./scripts/migrate-organization-integrity.ts",
    "prepush": "pnpm run migrate:organization-integrity",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "prepush-force": "pnpm run migrate:organization-integrity",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "test": "node --test --experimental-strip-types ./scripts/*.test.ts",
    "seed:construction-classifications": "node --experimental-strip-types ./scripts/seed-construction-classifications.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
